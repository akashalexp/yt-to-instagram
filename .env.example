# ── Instagram Graph API ──────────────────────────────────────────────────────
# Long-lived Page Access Token (see SETUP.md for how to obtain this)
INSTAGRAM_ACCESS_TOKEN=your_long_lived_page_access_token_here

# Your Instagram Business/Creator Account ID (numeric, e.g. 17841400000000000)
INSTAGRAM_USER_ID=your_instagram_user_id_here

# ── Only needed for local development ────────────────────────────────────────
# On Render, RENDER_EXTERNAL_URL is set automatically — you don't need this.
# Locally, Instagram cannot reach localhost, so this app won't work fully
# without a tunnel (ngrok etc.) or deploying to Render.
# RENDER_EXTERNAL_URL=https://your-app-name.onrender.com
