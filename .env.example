# ── Instagram Graph API ──────────────────────────────────────────────────────
INSTAGRAM_ACCESS_TOKEN=your_long_lived_page_access_token_here
INSTAGRAM_USER_ID=your_instagram_user_id_here

# ── YouTube Cookies (required on Render to bypass bot detection) ─────────────
# 1. Install "Get cookies.txt LOCALLY" Chrome extension
# 2. Go to youtube.com while logged in → click extension → Export
# 3. Open the downloaded cookies.txt → copy ALL the text
# 4. Paste it as the value of this variable in Render's environment settings
YOUTUBE_COOKIES=
